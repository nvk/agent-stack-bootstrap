# Public compatibility contract for agent-stack-bootstrap.
# These are intentionally version ranges, not private machine paths or hashes.
# Override in profile.env/local/profile.env only after retesting your generated stack.

AGENT_STACK_CHECK_TOOLS="${AGENT_STACK_CHECK_TOOLS:-nono bondage envchain-xtra node codex claude-code opencode}"

AGENT_STACK_REQUIRE_NONO="${AGENT_STACK_REQUIRE_NONO:->=0.61.0 <0.62.0}"
AGENT_STACK_REQUIRE_BONDAGE="${AGENT_STACK_REQUIRE_BONDAGE:->=0.2.7 <0.3.0}"
AGENT_STACK_REQUIRE_ENVCHAIN_XTRA="${AGENT_STACK_REQUIRE_ENVCHAIN_XTRA:->=1.3.1 <2.0.0}"
AGENT_STACK_REQUIRE_NODE="${AGENT_STACK_REQUIRE_NODE:->=26.0.0 <27.0.0}"
AGENT_STACK_REQUIRE_CODEX="${AGENT_STACK_REQUIRE_CODEX:->=0.136.0 <0.137.0}"
AGENT_STACK_REQUIRE_CLAUDE_CODE="${AGENT_STACK_REQUIRE_CLAUDE_CODE:->=2.1.112 <2.2.0}"
AGENT_STACK_REQUIRE_OPENCODE="${AGENT_STACK_REQUIRE_OPENCODE:->=1.14.40 <1.16.0}"

# Optional: pin nono packs used by a private overlay. Public profiles do not
# depend on these packs, so this is empty by default. Format:
#   AGENT_STACK_REQUIRE_NONO_PACKS="always-further/codex=0.0.12 always-further/claude=0.0.16"
AGENT_STACK_REQUIRE_NONO_PACKS="${AGENT_STACK_REQUIRE_NONO_PACKS:-}"
